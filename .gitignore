node_modules
.turbo
dist
packages/tokens/output
instructions
tokens-update

# Build output / test artifacts
storybook-static/
coverage/
# Playwright's own outputs. These were tracked by accident: a report is a
# snapshot of one machine's run, so committing it means every test run shows up
# as a diff. The baselines under visual/__screenshots__/ ARE committed — those
# are the oracle, not output.
playwright-report/
test-results/
# Per-gate JSON reports; scripts/quality/aggregate.mjs reads them and writes the
# one file that IS committed, manifest/test-status.json.
.quality/
# Assembled Cloudflare Workers deploy directory (scripts/assemble-site.mjs)
_site/

# Caches
.vite/
.eslintcache

# Logs
*.log

# OS / editor junk
.DS_Store
Thumbs.db

# Local env files (secrets, Measurement IDs, site keys) — never commit
.env
.env.local
.env.*.local
# Internal docs kept local, not published
RELEASING.md
Connect.md
COMPONENT-PLUGIN.md
MIGRATION.md
FIGMA-PARITY.md

# Internal spec / build-plan docs (kept local, not published)
tooling/token-editor/
apps/marketing/SITE.md
# Anchored, so a future packages/*/TABLE.md readme isn't swallowed too.
/TABLE.md

# Internal operational docs (kept local, not published).
# Anchored to the repo root: an unanchored `docs/` also swallows source
# directories that happen to be named docs, e.g. apps/marketing/src/docs/.
/docs/
# Stray exports / unused source assets (not used in production)
svg-animations/
/theme.json
.wrangler/

{
  "name": "design-system",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "typecheck:packages": "turbo typecheck --filter=./packages/* --filter=./tooling/*",
    "clean": "turbo clean && rm -rf node_modules",
    "generate:palette": "node scripts/generate-core-palette.mjs",
    "generate:release-dates": "node scripts/sync-release-dates.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "smoke": "pnpm --filter @ui-organized/cli test:smoke && pnpm --filter @ui-organized/react test:smoke && pnpm --filter @ui-organized/react-table test:smoke && pnpm --filter @ui-organized/svelte test:smoke && pnpm --filter @ui-organized/vue test:smoke && pnpm --filter @ui-organized/angular test:smoke && pnpm --filter @ui-organized/vue-table test:smoke && pnpm --filter @ui-organized/svelte-table test:smoke && pnpm --filter @ui-organized/angular-table test:smoke",
    "release": "turbo run build --filter=./packages/* && pnpm smoke && changeset publish",
    "quality": "node scripts/quality/run.mjs",
    "quality:lint": "node scripts/quality/lint.mjs",
    "quality:unit": "node scripts/quality/unit.mjs",
    "quality:visual": "pnpm --filter @ui-organized/storybook test:visual",
    "quality:interaction": "pnpm --filter @ui-organized/storybook test:interaction",
    "quality:a11y": "pnpm --filter @ui-organized/storybook test:a11y",
    "quality:browsers": "pnpm --filter @ui-organized/storybook test:browsers",
    "quality:aggregate": "node scripts/quality/aggregate.mjs",
    "check:tarballs": "node scripts/check-tarballs.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@turbo/gen": "^2.0.0",
    "@ui-organized/eslint-config": "workspace:*",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "stylelint": "^17.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}

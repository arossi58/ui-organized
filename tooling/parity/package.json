{
  "name": "@ui-organized/parity",
  "version": "0.0.0",
  "private": true,
  "description": "Asserts that every ui-organized framework library renders the same DOM contract.",
  "type": "module",
  "exports": {
    "./cases": "./src/cases/index.ts",
    "./angular-fixtures": "./browser/fixtures/angular/index.ts",
    "./parity-props": "./browser/fixtures/angular/parity-props.ts"
  },
  "scripts": {
    "build:deps": "node scripts/build-deps.mjs",
    "pretest": "pnpm build:deps",
    "test": "vitest run",
    "pretest:browser": "pnpm build:deps",
    "test:browser": "playwright test",
    "test:browser:run": "playwright test",
    "harness": "vite --config browser/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ui-organized/angular": "workspace:*",
    "@ui-organized/core": "workspace:*",
    "@ui-organized/react": "workspace:*",
    "@ui-organized/react-table": "workspace:*",
    "@ui-organized/table-core": "workspace:*",
    "@ui-organized/svelte": "workspace:*",
    "@ui-organized/tokens": "workspace:*",
    "@ui-organized/vue": "workspace:*",
    "@ui-organized/vue-table": "workspace:*"
  },
  "devDependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@ui-organized/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^29.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rxjs": "^7.8.0",
    "svelte": "^5.56.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0"
  }
}

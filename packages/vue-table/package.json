{
  "name": "@ui-organized/vue-table",
  "version": "0.1.0",
  "description": "Vue data table for the ui-organized design system: headless composable, styled parts, and a batteries-included <DataTable>, built on @ui-organized/table-core.",
  "keywords": [
    "design-system",
    "vue",
    "data-table",
    "table",
    "virtualization",
    "accessible"
  ],
  "license": "Apache-2.0",
  "author": "arossi58 <arossi5861@gmail.com>",
  "homepage": "https://github.com/arossi58/ui-organized/tree/main/packages/vue-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arossi58/ui-organized.git",
    "directory": "packages/vue-table"
  },
  "bugs": {
    "url": "https://github.com/arossi58/ui-organized/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "node ../../scripts/smoke-table.mjs vue"
  },
  "peerDependencies": {
    "@ui-organized/vue": ">=0.1.0",
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@tanstack/vue-table": "^9.2.4",
    "@tanstack/vue-virtual": "^3.13.36",
    "@ui-organized/table-core": "workspace:*",
    "@ui-organized/utils": "workspace:*",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@ui-organized/tsconfig": "workspace:*",
    "@ui-organized/vue": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}

{
  "name": "@ui-organized/vue",
  "version": "0.1.0",
  "description": "Vue component library for the ui-organized design system, built on Ark UI.",
  "keywords": ["design-system", "vue", "components", "ui", "ark-ui", "accessible"],
  "license": "Apache-2.0",
  "author": "arossi58 <arossi5861@gmail.com>",
  "homepage": "https://github.com/arossi58/ui-organized/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arossi58/ui-organized.git",
    "directory": "packages/vue"
  },
  "bugs": { "url": "https://github.com/arossi58/ui-organized/issues" },
  "sideEffects": ["**/*.css", "./dist/icons/*.js"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/lucide": {
      "types": "./dist/icons/entry-lucide.d.ts",
      "import": "./dist/icons/entry-lucide.js"
    },
    "./icons/tabler": {
      "types": "./dist/icons/entry-tabler.d.ts",
      "import": "./dist/icons/entry-tabler.js"
    },
    "./icons/heroicons": {
      "types": "./dist/icons/entry-heroicons.d.ts",
      "import": "./dist/icons/entry-heroicons.js"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "node scripts/smoke-icons.mjs"
  },
  "peerDependencies": {
    "@heroicons/vue": ">=2.0.0",
    "@lucide/vue": ">=1.0.0",
    "@tabler/icons-vue": ">=3.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@lucide/vue": {
      "optional": true
    },
    "@tabler/icons-vue": {
      "optional": true
    },
    "@heroicons/vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@ark-ui/vue": "^5.39.0",
    "@ui-organized/core": "workspace:*",
    "@ui-organized/utils": "workspace:*",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.33.0",
    "@tabler/icons-vue": "^3.46.0",
    "@types/node": "^20.0.0",
    "@ui-organized/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}

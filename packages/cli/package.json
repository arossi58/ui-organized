{
  "name": "@ui-organized/cli",
  "version": "0.2.0",
  "description": "Apply a UI Organized theme bundle to a project, and check it actually works — token coverage, font loading, and cascade conflicts.",
  "keywords": [
    "design-system",
    "design-tokens",
    "cli",
    "theme",
    "ui-organized"
  ],
  "license": "Apache-2.0",
  "author": "arossi58 <arossi5861@gmail.com>",
  "homepage": "https://github.com/arossi58/ui-organized/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arossi58/ui-organized.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/arossi58/ui-organized/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "uiorg": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@ui-organized/tsconfig": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}

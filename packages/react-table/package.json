{
  "name": "@ui-organized/react-table",
  "version": "0.1.0",
  "description": "React data table for the ui-organized design system: headless hook, styled parts, and a batteries-included <DataTable>, built on @ui-organized/table-core.",
  "keywords": [
    "design-system",
    "react",
    "data-table",
    "table",
    "virtualization",
    "accessible"
  ],
  "license": "Apache-2.0",
  "author": "arossi58 <arossi5861@gmail.com>",
  "homepage": "https://github.com/arossi58/ui-organized/tree/main/packages/react-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arossi58/ui-organized.git",
    "directory": "packages/react-table"
  },
  "bugs": {
    "url": "https://github.com/arossi58/ui-organized/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/index.css"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./dist/index.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node ../../scripts/smoke-table.mjs react"
  },
  "peerDependencies": {
    "@ui-organized/react": ">=5.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.10.0",
    "@ui-organized/table-core": "workspace:*",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@ui-organized/react": "workspace:*",
    "@ui-organized/tsconfig": "workspace:*",
    "jsdom": "^29.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
